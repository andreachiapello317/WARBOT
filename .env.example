# Token del bot Telegram (obbligatorio per bot.py). Lo trovi da @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AA-ilTuoTokenQui

# --- Produzione su Render (webhook) ---
# URL pubblico HTTPS del Web Service, SENZA slash finale.
# Se impostata il bot parte in webhook; se vuota, in polling (sviluppo locale).
WEBHOOK_URL=

# Porta HTTP. Su Render viene iniettata automaticamente.
PORT=10000

# Percorso del webhook (default: webhook).
WEBHOOK_PATH=webhook
