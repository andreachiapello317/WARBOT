# Token del bot Telegram (obbligatorio per bot.py). Lo trovi da @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AA-ilTuoTokenQui

# --- Produzione su Render (webhook) ---
# URL pubblico HTTPS del Web Service, SENZA slash finale.
# Se impostata il bot parte in webhook; se vuota, in polling (sviluppo locale).
WEBHOOK_URL=

# Porta HTTP. Su Render viene iniettata automaticamente.
PORT=10000

# Percorso del webhook (default: webhook).
WEBHOOK_PATH=webhook

# Geocoder OSM WORLD: photon (default, timeout breve) o nominatim. Cache memoria+file.
# OSM_GEOCODER=photon
# OSM_GEOCODER_URL=
# OSM_GEOCODER_TIMEOUT=4
# OSM_NOMINATIM_TIMEOUT=8
# OSM_CACHE_TTL_GEOCODE=21600
# OSM_CACHE_TTL_OVERPASS=10800
# OSM_CACHE_FILE=data/osm_cache.json
# OSM_OVERPASS_TIMEOUT=18
# OSM_OVERPASS_QL_TIMEOUT=20
# OSM_OVERPASS_FIRST_TIMEOUT=18
# Overpass default: maps.mail.ru. Lascia vuoto su Render.
# OSM_OVERPASS_URL=
# OSM_OVERPASS_RETRIES=1
# OSM_OVERPASS_LIMIT=40
# OSM_RESULT_LIMIT=20
# OSM_PAGE_CAP=40
# OSM_FALLBACK_MIN=4

# --- OPEN SKY (OAuth2 client credentials, obbligatorio) ---
# Su Render → Environment Variables (mai in GitHub):
# OPENSKY_CLIENT_ID=...-api-client
# OPENSKY_CLIENT_SECRET=...
# Senza queste due variabili il mondo OpenSky non interroga l'API.
# OPENSKY_RADIUS_KM=50
# OPENSKY_TIMEOUT=8
# OPENSKY_CACHE_TTL=10
# OPENSKY_PAGE_SIZE=20
# Opzionale: proxy HTTPS se OpenSky blocca l'IP cloud (non committare user:pass).
# OPENSKY_PROXY=
